# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
WALLET_ENCRYPTION_KEY=change-me-32-byte-fernet-key=

# ── Environment ───────────────────────────────────────────────────────────────
DEBUG=False
ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────────────────────────
# Option A – full DATABASE_URL (Railway / Render postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B – individual fields (if not using DATABASE_URL)
# DB_ENGINE=postgresql
# DB_NAME=sikka_db
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# ── Hosts & CORS ──────────────────────────────────────────────────────────────
ALLOWED_HOSTS=yourdomain.railway.app,yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.railway.app,https://yourdomain.com
FRONTEND_BASE_URL=https://yourdomain.railway.app

# ── Email (Gmail SMTP with App Password) ─────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=SIKKA Blockchain <your@gmail.com>
